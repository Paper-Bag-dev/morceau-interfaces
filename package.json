{
  "name": "morceau",
  "version": "0.3.0",
  "description": "Morceau: ephemeral, agent-driven UI for Windows and macOS. Borderless, transparent, self-expiring windows (cards, charts, forms, 3D) that an AI agent shows through a CLI (morc) or MCP.",
  "license": "MIT",
  "author": "Paper-Bag-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paper-Bag-dev/morceau-interfaces.git"
  },
  "homepage": "https://github.com/Paper-Bag-dev/morceau-interfaces#readme",
  "bugs": {
    "url": "https://github.com/Paper-Bag-dev/morceau-interfaces/issues"
  },
  "bin": {
    "morc": "bin/morc.js",
    "morceau": "bin/morc.js"
  },
  "os": [
    "win32",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "!bin/native/selected.txt",
    "ui/",
    "!ui/models/assets/**",
    "tools/",
    "cache/seed/",
    "cache/fragments/",
    "cache/recipes/",
    "docs/",
    "examples/",
    "integrations/",
    "scripts/",
    "AGENTS.md",
    "CLAUDE.md",
    "LICENSE",
    "THIRD-PARTY.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "chalk": "^4.1.2"
  },
  "scripts": {
    "prepare": "node scripts/npm/build-from-source.js",
    "prepublishOnly": "node scripts/npm/check-publish.js"
  },
  "keywords": [
    "ui",
    "agent",
    "ai",
    "claude",
    "cli",
    "windows",
    "macos",
    "webview2",
    "wkwebview",
    "overlay",
    "widgets",
    "ephemeral",
    "claude-code",
    "mcp",
    "ai-agent",
    "agent-ui",
    "generative-ui",
    "llm",
    "anthropic",
    "claude-code-plugin",
    "claude-skills",
    "desktop-widgets",
    "floating-window",
    "notifications",
    "dashboard",
    "charts",
    "windows-11",
    "fluent",
    "acrylic",
    "liquid-glass",
    "preact",
    "tailwind",
    "tool-use",
    "human-in-the-loop"
  ]
}
