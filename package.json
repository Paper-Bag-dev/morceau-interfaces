{
  "name": "morceau",
  "version": "0.1.4",
  "description": "Morceau: ephemeral, agent-driven UI for Windows. Borderless, transparent, self-expiring windows (cards, charts, forms, 3D) that an AI agent shows through a CLI (morc).",
  "license": "MIT",
  "author": "Paper-Bag-dev",
  "repository": { "type": "git", "url": "git+https://github.com/Paper-Bag-dev/morceau-interfaces.git" },
  "homepage": "https://github.com/Paper-Bag-dev/morceau-interfaces#readme",
  "bugs": { "url": "https://github.com/Paper-Bag-dev/morceau-interfaces/issues" },
  "bin": { "morc": "bin/morc.js", "morceau": "bin/morc.js" },
  "os": ["win32"],
  "cpu": ["x64"],
  "engines": { "node": ">=16" },
  "files": [
    "bin/",
    "ui/",
    "!ui/models/assets/**",
    "tools/",
    "cache/seed/",
    "cache/fragments/",
    "cache/recipes/",
    "docs/",
    "examples/",
    "integrations/",
    "scripts/",
    "AGENTS.md",
    "CLAUDE.md",
    "LICENSE",
    "THIRD-PARTY.md",
    "README.md"
  ],
  "scripts": {
    "prepare": "node scripts/build-from-source.js",
    "prepublishOnly": "node scripts/check-publish.js"
  },
  "keywords": ["ui", "agent", "ai", "claude", "cli", "windows", "webview2", "overlay", "widgets", "ephemeral", "claude-code", "mcp"]
}
