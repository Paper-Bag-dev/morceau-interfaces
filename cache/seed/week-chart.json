{
  "t": "save",
  "name": "week-chart",
  "desc": "7-day bar/line chart with a title. Pass /title, /values (7 numbers), /labels (7 strings), /unit.",
  "params": [
    "/title",
    "/values",
    "/labels",
    "/unit"
  ],
  "opts": {
    "min": [
      260,
      150
    ],
    "ttl": 25,
    "topic": "charts.week",
    "importance": "0.7",
    "size": "large",
    "actions": {
      "set": [
        {
          "do": "set",
          "path": "/values",
          "value": "$.values"
        },
        {
          "do": "set",
          "path": "/labels",
          "value": "$.labels"
        }
      ],
      "title": [
        {
          "do": "set",
          "path": "/title",
          "value": "$.text"
        }
      ]
    }
  },
  "components": [
    {
      "id": "root",
      "type": "column",
      "gap": 6,
      "children": [
        "c"
      ]
    },
    {
      "id": "c",
      "type": "chart",
      "kind": "bar",
      "title": "{/title}",
      "data": {
        "bind": "/values"
      },
      "labels": {
        "bind": "/labels"
      },
      "height": 110,
      "unit": "m"
    }
  ],
  "data": {
    "title": "Focus minutes, last 7 days",
    "values": [
      30,
      45,
      20,
      60,
      50,
      15,
      95
    ],
    "labels": [
      "Mon",
      "Tue",
      "Wed",
      "Thu",
      "Fri",
      "Sat",
      "Sun"
    ]
  }
}
