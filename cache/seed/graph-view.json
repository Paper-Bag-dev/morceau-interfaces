{
  "t": "save",
  "name": "graph-view",
  "desc": "Any node-link graph (code, goals, dependencies, flows) on Cytoscape: draggable nodes, labelled layers, an optional animated route. Pass /graph in the schema of docs/graphs.md and /title. `morc graph ...` fills it from the code graph or a JSON file.",
  "params": [
    "/title",
    "/graph"
  ],
  "opts": {
    "min": [
      640,
      380
    ],
    "ttl": 120,
    "topic": "viz.graph",
    "size": "large"
  },
  "components": [
    {
      "id": "root",
      "type": "column",
      "gap": 8,
      "children": [
        "t",
        "g"
      ]
    },
    {
      "id": "t",
      "type": "text",
      "size": "lg",
      "text": "{/title}"
    },
    {
      "id": "g",
      "type": "graph",
      "data": {
        "bind": "/graph"
      },
      "width": 880,
      "height": 500
    }
  ],
  "data": {
    "title": "Graph",
    "graph": {}
  }
}