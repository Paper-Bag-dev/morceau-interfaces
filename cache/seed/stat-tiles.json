      "unit": "{/a/unit}"
    },
    {
      "id": "b",
      "type": "stat",
      "label": "{/b/label}",
      "value": "{/b/value}",
      "unit": "{/b/unit}"
    },
    {
      "id": "c",
      "type": "stat",
      "label": "{/c/label}",
      "value": "{/c/value}",
      "unit": "{/c/unit}"
    },
    {
      "id": "d",
      "type": "stat",
      "label": "{/d/label}",
      "value": "{/d/value}",
      "unit": "{/d/unit}"
    }
  ],
  "data": {
    "a": {
      "label": "Focus today",
      "value": 95,
      "unit": "min"
    },
    "b": {
      "label": "Tasks done",
      "value": 4,
      "unit": "tasks"
    },
    "c": {
      "label": "Breaks",
      "value": 3,
      "unit": "breaks"
    },
    "d": {
