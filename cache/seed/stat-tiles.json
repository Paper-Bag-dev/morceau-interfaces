{
  "t": "save",
  "name": "stat-tiles",
  "desc": "Four big numbers together in one text card, in a line (they wrap only when the room is narrow), each with a label and unit. Pass /a /b /c /d, each {label, value, unit}. The text counterpart of the picture cards (donut-card, week-chart).",
  "params": [
    "/a/label",
    "/a/value",
    "/a/unit",
    "/b/label",
    "/b/value",
    "/b/unit",
    "/c/label",
    "/c/value",
    "/c/unit",
    "/d/label",
    "/d/value",
    "/d/unit"
  ],
  "opts": {
    "min": [
      320,
      200
    ],
    "ttl": 90,
    "topic": "stats.tiles",
    "importance": "0.85",
    "size": "chip"
  },
  "components": [
    {
      "id": "root",
      "type": "column",
      "gap": 8,
      "children": [
        "r1"
      ]
    },
    {
      "id": "r1",
      "type": "row",
      "gap": 8,
      "children": [
        "a",
        "b",
        "c",
        "d"
      ]
