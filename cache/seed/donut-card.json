{
  "t": "save",
  "name": "donut-card",
  "desc": "One donut chart with a title: share of a whole, values in millions (M). Pass /title, /values (numbers), /labels (short names).",
  "params": [
    "/title",
    "/values",
    "/labels"
  ],
  "opts": {
    "min": [
      150,
      150
    ],
    "ttl": 90,
    "topic": "charts.donut",
    "importance": "0.7",
    "size": "medium"
  },
  "components": [
    {
      "id": "root",
      "type": "column",
      "gap": 6,
      "children": [
        "c"
      ]
    },
    {
      "id": "c",
      "type": "chart",
      "kind": "donut",
      "title": "{/title}",
      "data": {
        "bind": "/values"
      },
      "labels": {
        "bind": "/labels"
      },
      "height": 120
    }
  ],
  "data": {
    "title": "Where the day went",
    "values": [
      180,
      95,
      60,
      45
    ],
    "labels": [
      "Work",
      "Study",
      "Gym",
      "Video"
    ]
  }
}
