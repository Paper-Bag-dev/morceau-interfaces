{
  "t": "save",
  "name": "bike-viewer",
  "desc": "Interactive 3D bike (three.js, procedural): drag to orbit, wheel to zoom, hover/click a part, Spin, Explode, repaint with swatches. Any model in ui/models/ works via the model3d component.",
  "params": [
    "/title",
    "/paint",
    "/spin",
    "/explode"
  ],
  "opts": {
    "min": [
      340,
      260
    ],
    "ttl": 600,
    "topic": "viz.model",
    "max_frac": 0.45,
    "size": "large"
  },
  "components": [
    {
      "id": "root",
      "type": "column",
      "gap": 10,
      "children": [
        "m",
        "bar"
      ]
    },
    {
      "id": "t",
      "type": "text",
      "size": "md",
      "text": "{/title}",
      "bold": true
    },
    {
      "id": "m",
      "type": "model3d",
      "model": "bike",
      "width": 380,
      "height": 240,
      "spin": {
        "bind": "/spin"
      },
      "explode": {
        "bind": "/explode"
      },
      "paint": {
        "bind": "/paint"
      },
      "hover": "/part",
      "pick": "/picked"
    },
    {
      "id": "tools",
      "type": "row",
      "children": [
        "spin",
        "explode",
        "c1",
        "c2",
        "c3",
        "c4"
      ]
    },
    {
      "id": "spin",
      "type": "button",
      "icon": "refresh",
      "label": "Spin",
      "pressed": {
        "bind": "/spin"
      },
      "action": {
        "do": "toggle",
        "path": "/spin"
      }
    },
    {
      "id": "explode",
      "type": "button",
      "icon": "arrow-right",
      "label": "Explode",
      "pressed": {
        "bind": "/explode"
      },
      "action": {
        "do": "toggle",
        "path": "/explode"
      }
    },
    {
      "id": "c1",
      "type": "button",
      "swatch": "#f4764e",
      "title": "Coral",
      "role": "tab",
      "pressed": {
        "bind": "/paint",
        "eq": "#f4764e"
      },
      "action": {
        "do": "set",
        "path": "/paint",
        "value": "#f4764e"
      }
    },
    {
      "id": "c2",
      "type": "button",
      "swatch": "#3d7bf4",
      "title": "Electric blue",
      "role": "tab",
      "pressed": {
        "bind": "/paint",
        "eq": "#3d7bf4"
      },
      "action": {
        "do": "set",
        "path": "/paint",
        "value": "#3d7bf4"
      }
    },
    {
      "id": "c3",
      "type": "button",
      "swatch": "#e9e6df",
      "title": "Pearl white",
      "role": "tab",
      "pressed": {
        "bind": "/paint",
        "eq": "#e9e6df"
      },
      "action": {
        "do": "set",
        "path": "/paint",
        "value": "#e9e6df"
      }
    },
    {
      "id": "c4",
      "type": "button",
      "swatch": "#2b2c30",
      "title": "Graphite",
      "role": "tab",
      "pressed": {
        "bind": "/paint",
        "eq": "#2b2c30"
      },
      "action": {
        "do": "set",
        "path": "/paint",
        "value": "#2b2c30"
      }
    },
    {
      "id": "bar",
      "type": "column",
      "gap": 6,
      "children": [
        "t",
        "tools"
      ]
    }
  ],
  "data": {
    "title": "Naked sport bike",
    "paint": "#f4764e",
    "spin": false,
    "explode": false,
    "part": "",
    "picked": ""
  }
}