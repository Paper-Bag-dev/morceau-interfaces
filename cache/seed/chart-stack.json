{
  "t": "save",
  "name": "chart-stack",
  "desc": "Two charts in ONE window, a donut over a bar chart: for a tall free side. Pass /pie {title, values, labels, unit} and /bars {title, values, labels, unit}; unit defaults to M.",
  "params": [
    "/pie/title",
    "/pie/values",
    "/pie/labels",
    "/pie/unit",
    "/bars/title",
    "/bars/values",
    "/bars/labels",
    "/bars/unit"
  ],
  "opts": {
    "min": [
      240,
      440
    ],
    "ttl": 90,
    "topic": "charts.stack",
    "importance": "0.7",
    "size": "large",
    "actions": {
      "setPie": [
        {
          "do": "merge",
          "path": "/pie",
          "value": "$"
        }
      ],
      "setBars": [
        {
          "do": "merge",
          "path": "/bars",
          "value": "$"
        }
      ]
    }
  },
  "components": [
    {
      "id": "root",
      "type": "column",
      "gap": 8,
      "children": [
        "pie",
        "bars"
      ]
    },
    {
      "id": "pie",
      "type": "chart",
      "kind": "donut",
      "title": "{/pie/title}",
      "data": {
        "bind": "/pie/values"
      },
      "labels": {
        "bind": "/pie/labels"
      },
      "unit": {
        "bind": "/pie/unit"
      },
      "height": 200
    },
    {
      "id": "bars",
      "type": "chart",
      "kind": "bar",
      "title": "{/bars/title}",
      "data": {
        "bind": "/bars/values"
      },
      "labels": {
        "bind": "/bars/labels"
      },
      "unit": {
        "bind": "/bars/unit"
      },
      "height": 200
    }
  ],
  "data": {
    "pie": {
      "title": "Where the day went",
      "values": [
        180,
        95,
        60,
        45
      ],
      "labels": [
        "all"
      ],
      "unit": "M"
    },
    "bars": {
      "title": "Focus per day",
      "values": [
        30,
        45,
        20,
        60,
        95
      ],
      "labels": [
        "a",
        "b",
        "c",
        "d",
        "e"
      ],
      "unit": "M"
    }
  }
}
