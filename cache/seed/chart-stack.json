{
  "t": "save",
  "name": "chart-stack",
  "desc": "Two charts in ONE window, a donut over a bar chart, with Close: for a tall free side. Pass /pie {title, values, labels} and /bars {title, values, labels}; values are in millions (M).",
  "params": [
    "/pie/title",
    "/pie/values",
    "/pie/labels",
    "/bars/title",
    "/bars/values",
    "/bars/labels"
  ],
  "opts": {
    "min": [
      240,
      300
    ],
    "ttl": 90,
    "topic": "charts.stack",
    "importance": "0.7",
    "size": "large"
  },
  "components": [
    {
      "id": "root",
      "type": "column",
      "gap": 8,
      "children": [
        "pie",
        "bars"
      ]
    },
    {
      "id": "pie",
      "type": "chart",
      "kind": "donut",
      "title": "{/pie/title}",
      "data": {
        "bind": "/pie/values"
      },
      "labels": {
        "bind": "/pie/labels"
      },
      "unit": "min",
      "height": 140
    },
    {
      "id": "bars",
      "type": "chart",
      "kind": "bar",
      "title": "{/bars/title}",
      "data": {
        "bind": "/bars/values"
      },
      "labels": {
        "bind": "/bars/labels"
      },
      "unit": "min",
      "height": 130
    }
  ],
  "data": {
    "pie": {
      "title": "Where the day went",
      "values": [
        180,
        95,
        60,
        45
      ],
      "labels": [
        "Work",
        "Study",
        "Gym",
        "Video"
      ]
    },
    "bars": {
      "title": "Focus per day",
      "values": [
        30,
        45,
        20,
        60,
        95
      ],
      "labels": [
        "Mon",
        "Tue",
        "Wed",
        "Thu",
        "Fri"
      ]
    }
  }
}
